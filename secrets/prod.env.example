# Templat lingkungan "prod" (TTN-OPS-004). HANYA placeholder. Nilai asli hidup di secret manager.
# Jangan menyalin ini menjadi .env yang di-commit; .gitignore memblokir .env*.
# Placeholder resmi: GANTI_DARI_SECRET_MANAGER

# DB tulis satu-satunya: DB logis "titeny" (user titeny_app, hak tulis hanya di sini)
DATABASE_URL=postgres://titeny_app:GANTI_DARI_SECRET_MANAGER@db-prod.titeny.internal:5432/titeny

# JWT ed25519 (aud=titeny, iss=chefgenie-auth). Privat hanya untuk penandatangan; publik untuk verifikasi.
JWT_ED25519_PRIVATE=GANTI_DARI_SECRET_MANAGER
JWT_ED25519_PUBLIC=GANTI_DARI_SECRET_MANAGER
JWT_AUDIENCE=titeny
JWT_ISSUER=chefgenie-auth

# Token layanan sumber event dan token registry
TITENY_API_TOKEN=GANTI_DARI_SECRET_MANAGER
GHCR_TOKEN=GANTI_DARI_SECRET_MANAGER

# Kredensial sumber S1-S10: role titeny_ro_sNN, HANYA hak SELECT (sql/source-readonly-role.sql)
SRC_S1_DATABASE_URL=postgres://titeny_ro_s01:GANTI_DARI_SECRET_MANAGER@sumber-s01.prod.internal:5432/GANTI_NAMA_DB_SUMBER?sslmode=require
